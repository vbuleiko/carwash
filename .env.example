# Copy to .env and fill in:  cp .env.example .env

# Your domain (DNS A record -> the VM's IP). For a test by IP: DOMAIN=:80 and COOKIE_SECURE=0
DOMAIN=carwasheasy.co.za

# Long random string. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for /admin (your back office). Leave empty to switch /admin off.
ADMIN_PASSWORD=

# Your WhatsApp number (international, digits only) for "Contact us" / "Subscribe" buttons
SUPPORT_WHATSAPP=27687826672
SUPPORT_EMAIL=admin@carwasheasy.co.za

APP_NAME=CarWashEasy
# Default look for the landing page and new car washes: carbon, volt, midnight, noir or classic
THEME=carbon
PRICE_MONTHLY=R349
PRICE_YEARLY=R3,990
TRIAL_DAYS=30
# Free plan in return for feedback
PILOT_DAYS=60

# Emails to you: each new sign-up and a daily report at 22:00 (Johannesburg). Empty SMTP_PASSWORD = no emails.
# Gmail: a separate account for sending, SMTP_PASSWORD = its app password (needs 2-Step Verification).
# Letters go from SMTP_USER. Check: sudo docker compose exec notify flask --app app report
NOTIFY_EMAIL=admin@carwasheasy.co.za
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Reads an uploaded price list (photos or PDF) into the owner's price list. Empty = no upload button.
# Key from platform.qubrid.com. Any vision model from https://platform.qubrid.com/v1/models
QUBRID_API_KEY=
QUBRID_MODEL=Qwen/Qwen3-VL-Flash

# 1 when the site runs on https (normal). 0 only for a test over plain http.
COOKIE_SECURE=1
