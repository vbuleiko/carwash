# DOMAIN comes from .env: "carwasheasy.co.za" gets a free HTTPS certificate automatically.
# For a quick test by IP address use DOMAIN=:80 (and COOKIE_SECURE=0).
{
	# car washes' own addresses (book.joeswash.co.za): a certificate on the first visit,
	# only for addresses saved in /admin
	on_demand_tls {
		ask http://app:8000/tls-check
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header Strict-Transport-Security "max-age=31536000"
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8000
	header Strict-Transport-Security "max-age=31536000"
}
